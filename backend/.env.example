# Backend environment
PORT=3001

# PostgreSQL connection - update after you create the DB user & database
# Recommended dedicated role (not superuser for prod)
DATABASE_URL=postgresql://scheduler:scheduler@localhost:5432/scheduler

# Optional: force SSL (for managed Postgres like Neon, Supabase, etc)
# PGSSL=true

# CORS - allow frontend origin (default allows localhost:3000)
CORS_ORIGIN=http://localhost:3000

# Node env
NODE_ENV=development
