# Backend environment
PORT=3001

# PostgreSQL connection - update after you create the DB user & database
# Recommended dedicated role (not superuser for prod)
DATABASE_URL=postgresql://scheduler:scheduler@localhost:5432/scheduler

# Optional: force SSL (for managed Postgres like Neon, Supabase, etc)
# PGSSL=true

# CORS - allow frontend origin (default allows localhost:3000)
CORS_ORIGIN=http://localhost:3000

# Node env
NODE_ENV=development

# JWT secret for auth (MUST be a long random string in production!)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-strong-random-string-for-prod

# Email (simulation for now - see src/utils/email.ts)
# When ready for real emails, configure nodemailer transporter with e.g.:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-key
# FROM_EMAIL=noreply@yourdomain.com
